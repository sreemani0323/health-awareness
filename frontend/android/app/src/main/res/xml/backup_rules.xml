<?xml version="1.0" encoding="utf-8"?>
<!--
    Full backup rules for Android 6.0 to Android 11 (API level 23 to 30).
    Explicitly excludes sensitive storage, Keystore-bound ciphertexts, and cached data.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
