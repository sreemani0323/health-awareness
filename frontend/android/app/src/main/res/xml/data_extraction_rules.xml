<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API level 31 and higher).
    Explicitly excludes sensitive storage, credentials, and cached drafts
    from both Google Cloud Backup and Device-to-Device (D2D) migration.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
