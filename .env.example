# =============================================================================
# HealthAware Environment Configuration Template
# =============================================================================
# Copy this file to .env and customize with your local configuration.
# Never commit real credentials or secrets to source control.

# Flask Application Settings
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-secure-random-key-in-production

# PostgreSQL Primary Database Connection (Local or Neon)
# Local example: postgresql://postgres:postgres@localhost:5432/healthaware
# Neon example:  postgresql://[user]:[password]@[endpoint].neon.tech/healthaware?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/healthaware

# Test Database Connection (Isolated from development database)
# Must be separate to prevent accidental test data pollution or destructive resets
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/healthaware_test

# Private Attachment / Photo Storage (Local development path outside public assets)
ATTACHMENT_STORAGE_DIR=./local_storage/attachments

# Source Datastore Emulator (Used for one-way migration utility)
DATASTORE_EMULATOR_HOST=127.0.0.1:8080
DATASTORE_PROJECT_ID=health-awareness-local

# Primary Transactional Email Dispatch: Google Gmail REST API (HTTPS Port 443)
# Recommended for Render Free tier (bypasses Render outbound SMTP port 465/587 blocks).
# No custom domain, DNS verification, or paid add-on required.
# Obtain via: python scripts/generate_gmail_oauth_token.py
# - GMAIL_CLIENT_ID: OAuth 2.0 Client ID from Google Cloud Console
# - GMAIL_CLIENT_SECRET: OAuth 2.0 Client Secret
# - GMAIL_REFRESH_TOKEN: Permanent OAuth 2.0 Refresh Token (from In-Production app)
# - GMAIL_SENDER_EMAIL: Authorized sender Gmail address (e.g. sreemani0323@gmail.com)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Alternative Transactional Email Dispatch: SMTP Outbound Relay
# For environments allowing outbound SMTP connections (Render Paid, AWS, Self-Hosted)
# Canonical Variable Names:
# - SMTP_HOST: Outbound relay host (e.g. smtp.sendgrid.net, smtp.resend.com, email-smtp.us-east-1.amazonaws.com)
# - SMTP_PORT: Relay port (587 for STARTTLS, 465 for SSL, 25 for unauthenticated relay; default: 587)
# - SMTP_USERNAME: Authentication username or API key user (e.g. apikey, resend)
# - SMTP_PASSWORD: Authentication password or API key secret
# - SMTP_FROM_EMAIL: Outbound sender address (e.g. no-reply@healthaware.org; default: noreply@healthaware.org)
# Backward-compatible aliases supported:
# - Host: SMTP_SERVER
# - Username: SMTP_USER
# - Password: SMTP_PASS
# - Sender: SMTP_FROM, EMAIL_FROM
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@healthaware.org


